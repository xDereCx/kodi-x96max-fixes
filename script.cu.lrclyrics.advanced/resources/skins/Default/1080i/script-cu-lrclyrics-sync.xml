<?xml version="1.0" encoding="UTF-8"?>
<!-- generic, skin-independent fallback for the sync-offset slider window
     (context menu "Sync", or up/down during timed lyrics). Aeon Nox 5 used
     to get its own more elaborately-styled copy of this file from
     script.xderecx.aeonnox5lyricsfix (AN5's own slider/background textures
     and font) - that copy was a stale hijack removed 2026-09-06, so this
     universal version is now what every skin, including AN5, actually
     uses. No <font> tag on the labels (falls back to the active skin's own
     Font.xml "Default" fontset, which every skin is required to define).
     Confirmed live 2026-09-07: a <control type="rectangle"> background and
     a <control type="slider"> with no explicit textures (the previous,
     "no texture file dependency" approach, assuming Kodi would fall back
     to its own built-in slider graphics) both rendered as literally
     nothing - only the 2 text labels were ever visible, no background box,
     no slider bar at all. Both switched to this addon's own already-proven
     working assets (culrc-black.png / culrc-white70.png, same ones the
     main dialog's translation panel backdrop uses) instead of relying on
     an assumed Kodi fallback that doesn't actually exist. -->
<window>
	<defaultcontrol>11</defaultcontrol>
	<controls>
		<control type="image">
			<left>360</left>
			<top>100</top>
			<width>1200</width>
			<height>150</height>
			<texture colordiffuse="C0000000">culrc-black.png</texture>
		</control>
		<control type="label" id="10">
			<description>Dialog header</description>
			<left>400</left>
			<top>115</top>
			<width>1120</width>
			<height>40</height>
			<align>center</align>
			<textcolor>white</textcolor>
		</control>
		<control type="slider" id="11">
			<description>Slider</description>
			<left>400</left>
			<top>160</top>
			<width>1120</width>
			<height>30</height>
			<onup>11</onup>
			<ondown>11</ondown>
			<onleft>11</onleft>
			<onright>11</onright>
			<texturesliderbar colordiffuse="white">culrc-white70.png</texturesliderbar>
			<textureslidernib colordiffuse="FFE0E0E0">culrc-white70.png</textureslidernib>
		</control>
		<control type="label" id="12">
			<description>Slider value</description>
			<left>400</left>
			<top>195</top>
			<width>1120</width>
			<height>35</height>
			<align>center</align>
			<textcolor>white</textcolor>
		</control>
	</controls>
</window>
