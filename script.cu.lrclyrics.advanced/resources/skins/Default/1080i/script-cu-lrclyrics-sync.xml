<?xml version="1.0" encoding="UTF-8"?>
<!-- generic, skin-independent fallback for the sync-offset slider window
     (context menu "Sync", or up/down during timed lyrics). Aeon Nox 5 used
     to get its own more elaborately-styled copy of this file from
     script.xderecx.aeonnox5lyricsfix (AN5's own slider/background textures
     and font) - that copy was a stale hijack removed 2026-09-06, so this
     universal version is now what every skin, including AN5, actually
     uses. No <font> tag on the labels (falls back to the active skin's own
     Font.xml "Default" fontset, which every skin is required to define).
     Confirmed live 2026-09-07: a <control type="rectangle"> background and
     a <control type="slider"> with no explicit textures (the previous,
     "no texture file dependency" approach, assuming Kodi would fall back
     to its own built-in slider graphics) both rendered as literally
     nothing - only the 2 text labels were ever visible, no background box,
     no slider bar at all. Both switched to this addon's own already-proven
     working assets (culrc-black.png / culrc-white70.png, same ones the
     main dialog's translation panel backdrop uses) instead of relying on
     an assumed Kodi fallback that doesn't actually exist. Confirmed live
     again the same day: a dim (50% white) track plus a same-texture,
     near-white nib for the position marker made the whole bar read as one
     flat white strip with no visible indicator of the current value -
     texturesliderbar stretches to the control's full size, but
     textureslidernib renders at its own texture's native pixel size
     (Kodi positions it along the bar automatically), so a generic 4x4
     placeholder texture made it functionally invisible. culrc-slidernib.png
     (a dedicated 26x40 solid-color marker) plus textureslidernibfocus
     (control 11 always has default focus, and the focus/no-focus nib
     textures are apparently not interchangeable) STILL never rendered
     visibly - gave up guessing at Kodi's native slider nib behavior and
     switched to a small separate image control (id 13) that sync.py
     positions explicitly via setPosition() every time the value changes,
     using the exact same left/width math as the slider itself. Control 11
     is still the slider actually handling up/down/left/right input and
     tracking the float value (untouched, was always fine) - it just no
     longer tries to render its own nib. -->
<window>
	<defaultcontrol>11</defaultcontrol>
	<controls>
		<control type="image">
			<left>360</left>
			<top>100</top>
			<width>1200</width>
			<height>150</height>
			<texture colordiffuse="C0000000">culrc-black.png</texture>
		</control>
		<control type="label" id="10">
			<description>Dialog header</description>
			<left>400</left>
			<top>115</top>
			<width>1120</width>
			<height>40</height>
			<align>center</align>
			<textcolor>white</textcolor>
		</control>
		<control type="slider" id="11">
			<description>Slider - input/value handling only, see id 13 for the visible position marker</description>
			<left>400</left>
			<top>160</top>
			<width>1120</width>
			<height>30</height>
			<onup>11</onup>
			<ondown>11</ondown>
			<onleft>11</onleft>
			<onright>11</onright>
			<texturesliderbar colordiffuse="80FFFFFF">culrc-white70.png</texturesliderbar>
		</control>
		<control type="image" id="13">
			<description>Slider position marker - positioned explicitly by sync.py's _position_marker(), not Kodi's native slider nib (never rendered, see comment above)</description>
			<left>400</left>
			<top>160</top>
			<width>26</width>
			<height>30</height>
			<texture colordiffuse="white">culrc-slidernib.png</texture>
		</control>
		<control type="label" id="12">
			<description>Slider value</description>
			<left>400</left>
			<top>195</top>
			<width>1120</width>
			<height>35</height>
			<align>center</align>
			<textcolor>white</textcolor>
		</control>
	</controls>
</window>
